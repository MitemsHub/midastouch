; MIDASTOUCH — LV arm preset, P6 WINNER (MidastouchAI_LV_TP15_M5_gold.set)
; ============================================================================
; STAGED 2026-09-18 (register §2b P6 build block) — DO NOT SPLICE ONTO THE
; LV CHART until the 2026-10-01 reading passes. This is the full P6-winner
; configuration: M5 entries + TP 1.5R, the highest positive-days % and
; median daily profit of all 36 studied configs that survived the OOS law
; (57.2% positive days, pf 1.368 full-span; OOS pf 1.150).
;
; Requires EA >= v1.19 (InpEntryTF parameter; PERIOD_M5 = 5). On any older
; binary this preset's InpEntryTF line is unknown input data — do NOT splice
; onto v1.16/1.18 charts.
;
; Evidence chain: midas_p6_income_study_20260918.json (36 configs, ranking
; frozen pre-run, Jan-Mar declared in-sample, Apr-Sep OOS law), M5 corpus
; fetched from the broker (midas_p6_m5_fetch.json), register §2b P6 row.
; Kill rules (registered): trailing 20-trade expectancy < -0.30R, or two
; consecutive full-loss days, reverts the arm to the certified M15 config.
;
; Deltas vs MidastouchAI_LV_gold.set: InpEntryTF=5, InpTpMult=1.5 — and
; NOTHING else (mode, trigger k=1.0/75-25, gates, risk law all identical).
InpMagic=7801601
InpArmTag=LV
InpMode=0
InpMacroEmaPeriod=20
InpBBPeriod=20
; Trigger: the 2026-09-18 LV amendment (k=1.0/75-25) — unchanged.
InpBBDev=1.0
InpRSIPeriod=14
InpRSIUpper=75.0
InpRSILower=25.0
InpAtrPeriod=14
InpSlAtrMult=2.0
; THE AMENDMENT: TP 1.5R (P6 winner shape).
InpTpMult=1.5
InpTimeoutMinutes=720
InpSessionStartHour=6
InpSessionEndHour=20
InpSpreadCapPctStop=1.5
InpFridayCutoffHour=20
InpUseNewsFilter=false
InpStaleMinutes=30
InpRiskPercent=1.0
InpMaxRiskPct=15.0
InpLiveExecution=true
InpPaperEquity=50.0
InpDeviationPoints=20
InpOrderRetries=3
InpFridayFlatHour=20
; Daily breaker: the LV registered 15.0 (paper arms keep 3.0).
InpDailyLossCapPct=15.0
; THE AMENDMENT: M5 entries (P6 winner timeframe; EA >= v1.19 required).
InpEntryTF=5
InpBarModel=false
InpSpreadFile=MIDASTOUCH_spread_M15.csv
InpWindowStart=0
InpWindowEnd=0
