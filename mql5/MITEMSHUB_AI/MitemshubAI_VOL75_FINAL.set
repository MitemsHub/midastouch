; MITEMSHUB V75 MACRO ENGINE v27.00 — PAPER/OFF profile
; Attach to Volatility 75 Index. Entry gate: first tick of each new M30 bar.
; Direction: previous H4 and H1 closes aligned around EMA20.
; Trigger: previous M30 close at BB(20,2) edge or RSI14 <=35/>=65.
; Risk: 1% equity target, SL=2x H1 ATR14, TP=4x H1 ATR14, hard timeout=3h.
; No order is submitted while InpLiveExecution=false.
InpLiveExecution=false
InpMagic=7788075
InpMaxDeviationPoints=50
InpDrawHud=true

; 2026-09-15: TickRecorder enabled for the paper arms (playbook F3 fix) — ONE recorder per terminal (shared symbol file); arms A+B cover all three arms forensically
InpTickRecordEnabled=true
InpTickFlushTicks=100
InpTickFlushSeconds=10
