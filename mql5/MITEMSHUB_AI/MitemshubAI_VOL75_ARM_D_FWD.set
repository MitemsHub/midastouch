; ============================================================
; MITEMSHUB ARM D — FORWARD TEST OF THE GATED CANDIDATE (v26.40)
; ============================================================
; Frozen parameters from artifacts/train/SPRINT_REPORT.json finalist 1
; (docs/SPRINT_ENTRY_REDESIGN_20260915.md) + the two participation gates
; validated in docs/OOS_AUTOPSY_20260915.md (BOTH = HTF-SLOPE + NO-MOM):
;
;   IS  2025-08-01..2026-06-01: +12.74R, n=116, DD 11.3%, streak <= 8
;   OOS 2026-06-01..2026-09-02: +1.53R, n=25, DD 3.8% (all gates PASS)
;
; These backtest numbers are NOT evidence of edge — the OOS window was
; consumed by the autopsy that designed NO-MOM (circularity caveat on
; record). This arm exists to accrue an INDEPENDENT window under the
; frozen adjudication in docs/ARM_D_FORWARD_TEST.md.
;
; Parity notes (why each flag is what it is):
;   - InpSelfCorrect=false: the v30 self-correcting engine has no lab
;     counterpart — must be OFF or the forward stats stop being comparable
;     to the validated candidate.
;   - InpAdaptiveConviction=true, InpMaxSpreadATRFrac=0.18, cooldown 3 bars
;     with win-rearm, consec-loss pause 3, TIME at 20 bars: the certified
;     harness (scripts/study_frozen_certify_v75.py) models all of these;
;     leaving them on preserves lab parity.
;   - InpTickRecordEnabled=false: one recorder per terminal owns the shared
;     MITEMSHUB_ticks file; arm B already records this feed.
;   - InpSessionStartHour=0 = InpSessionEndHour=0: session gate always open
;     (24/7 collection), matching the lab's unbounded clock.
;   - InpArmTag=D: suffixes ALL Files output so arm D can share the
;     dedicated terminal + symbol with arm B without file collisions.
;
; Attach to: Volatility 75 Index, M15 chart, dedicated paper terminal.
; PAPER ONLY: InpLiveExecution=false — no real order can ever be sent.
; ============================================================
InpLiveExecution=false
InpMagic=7788150
InpArmTag=D
InpPaperEquity=50.0
InpPaperSpreadMult=1.0
InpMaxDeviationPoints=50

; --- strategy mix: kernel = trend-side pullback; MR and BF are OFF (validated) ---
InpUsePullback=true
InpUseBreakout=false
InpUseMomentum=true
InpUseMeanRevert=false
InpUseBandFade=false
InpMinScore=3
InpRequire2Strats=false
InpMomentumStandalone=false
InpSelfCorrect=false

; --- participation gates (OOS-autopsy BOTH; off = exact v26.39 behaviour) ---
InpNoMomGate=true
InpHtfSlopeGate=true
InpHtfSlopeEma=100

; --- regime machinery (lab defaults) ---
InpEmaFast=20
InpEmaMid=50
InpEmaSlow=100
InpMinEmaSep=0.22
InpAtrPeriod=14
InpAtrLookback=120
InpAtrLowPct=8.0
InpAtrHighPct=90.0

; --- rebuilt entry geometry (sprint finalist 1, frozen) ---
InpPullbackMin=0.60
InpPullbackMax=0.70
InpPbEmaSideVeto=true
InpTpMult=1.6

; --- exits: BE at +1R, PLOCK at 0.5R, trail from +1R at 0.7R, TIME 20 bars ---
InpUseBreakeven=true
InpBeTriggerR=1.0
InpProfitLockR=0.5
InpUseTrailing=true
InpTrailStartR=1.0
InpTrailDistR=0.7
InpMaxHoldBars=20

; --- governor (harness-modelled) ---
InpMaxSpreadATRFrac=0.18
InpAdaptiveConviction=true
InpCoolDownBars=1
InpWinRearm=true
InpMaxConsecLoss=3
InpMaxDailyLossPct=0.0
InpMaxTradesPerDay=0

; --- risk & routing ($50 virtual basis; guard inputs identical to fleet) ---
InpRiskPerTrade=0.005
InpMaxEffectiveRiskPct=20.0
InpMicroFitPct=1.5
InpFitRouter=true
InpFleetMagicsCSV=7788010,7788025,7788050,7788075,7788100,7788150
InpSameSymbolMaxPos=1

; --- collection: 24/7, M15 entry / H1 regime (chart = M15) ---
InpEntryTFOverride=CURRENT
InpRegimeTFOverride=CURRENT
InpSessionStartHour=0
InpSessionEndHour=0
InpSessionEndOffsetMin=45
InpWarmupBars=250

; --- TickRecorder: OFF here — arm B owns this terminal's shared tick file ---
InpTickRecordEnabled=false
InpTickFlushTicks=100
InpTickFlushSeconds=10

; --- display ---
InpDrawDashboard=true
InpDrawSignals=true
InpUseMetaLabel=false
